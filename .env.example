# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_WEB_CLIENT_ID: Web Client ID from Google Cloud Console / Firebase Console
# (Type: Web application OAuth 2.0 Client ID)
# e.g., 760692900373-xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID=not_configured
